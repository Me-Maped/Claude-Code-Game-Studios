; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="LynxFramework"
config/description="LynxFramework — Modular Game Framework for Godot 4.x"
config/version="0.1.0"
run/main_scene="res://src/lynx-framework/Tests/FullIntegrationTestScene.tscn"
config/features=PackedStringArray("4.6", "C#")

[autoload]

FrameworkEntry="*res://src/lynx-framework/FrameworkEntry.cs"

[dotnet]

project/assembly_name="LynxFramework"
